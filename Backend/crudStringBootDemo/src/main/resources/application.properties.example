spring.application.name=crudStringBootDemo
spring.datasource.url=jdbc:mysql://localhost:3306/student_crud_db
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

app.admin.username=admin
app.admin.password=CHANGE_ME
app.jwt.secret=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_OR_MORE_CHARACTERS
app.jwt.expiration-ms=86400000